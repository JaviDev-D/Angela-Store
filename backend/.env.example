# Copia este archivo como ".env" y ajusta los valores según tu entorno.
# NUNCA subas el archivo ".env" real al repositorio.

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root
DB_NAME=angela_store
DB_PORT=3306
# Cambia a "true" si tu proveedor de MySQL en la nube exige conexión SSL
DB_SSL=false

PORT=3000

# Origen permitido para CORS (URL del frontend)
# En producción, cámbialo por la URL real de tu frontend desplegado
CORS_ORIGIN=http://127.0.0.1:5500
